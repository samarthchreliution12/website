# Dynamic CMS Data Switch Toggle
# Set to 'true' to load blogs from your Custom CMS Node.js Express server.
# Set to 'false' (or leave empty) to continue loading blogs from Sanity.
NEXT_PUBLIC_USE_CUSTOM_CMS=false

# Custom CMS API Endpoint URL
NEXT_PUBLIC_CMS_API_URL=http://localhost:4000/api

# Sanity Studio Configuration (Retained)
NEXT_PUBLIC_SANITY_PROJECT_ID=c30se3qv
NEXT_PUBLIC_SANITY_DATASET=production
